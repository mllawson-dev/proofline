# Leave all of these empty to run the sample-data demo (what the public portfolio deployment does).
# Fill them in to run against your own Firebase project. Full steps: docs/going-live.md

# Firebase web app settings (Firebase console → Project settings → Your apps). Safe to expose in the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Never commit real values.
# The service account JSON on one line (Project settings → Service accounts → Generate new private key).
FIREBASE_SERVICE_ACCOUNT=
# A long random string that signs customer proof links: `openssl rand -base64 48`
PROOF_LINK_SECRET=
