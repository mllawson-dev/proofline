{
  "name": "proofline",
  "version": "1.0.0",
  "private": true,
  "description": "Job tracker for a sign and print shop: order intake, proof approval, production and quality check. A portfolio concept by Michael L. Lawson.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-proofline \"vitest run --config vitest.rules.config.ts\"",
    "seed:firestore": "tsx scripts/seed-firestore.ts",
    "set-role": "tsx scripts/set-role.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tanstack/react-table": "8.21.3",
    "firebase": "13.4.0",
    "firebase-admin": "14.5.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "firebase-tools": "15.37.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
